    "@tailwindcss/vite": "^4.1.14",
    "@vercel/blob": "^2.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^13.4.0",
    "hono": "^4.13.1",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^6.6.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
