{
  "name": "catchingjobs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "react-router dev",
    "build": "prisma generate --schema=apps/api/prisma/schema.prisma && react-router build",
    "preview": "react-router-serve dist/server/*/index.js",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "tsx apps/api/prisma/scripts/auto-seed.ts",
    "quality-check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test:e2e:framework": "playwright test --config=tests/playwright.framework.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/backend": "^3.16.11",
    "@clerk/clerk-react": "^5.61.9",
