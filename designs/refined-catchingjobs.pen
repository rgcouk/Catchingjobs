    {
      "type": "frame",
      "id": "c1VBCR",
      "x": 117.99999999999909,
      "y": -40664,
      "name": "23A · Research and motion direction",
      "width": 1440,
      "height": 380,
      "fill": "#FFFDF0",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "ssgHY",
          "name": "Approach",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Editorial confidence — poster hierarchy, recruitment clarity",
          "lineHeight": 1.35,
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 26,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "uY5aO",
          "name": "Artist research",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Bruno Justo Pego: 90 days / 90 posters and flat character studies. Dribbble: https://brunojustopego.dribbble.com/\nAkshat: To the Max typography poster series. Behance: https://www.behance.net/gallery/249473893/To-the-MaxTypography-Poster-Series",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "JC6Lt",
          "name": "Original direction",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Borrow poster discipline, never lettering or artwork. Our stamp: a stepped, high-contrast headline field; deep scene crop; ivory benefits forming the next-section transition. Brand palette and Chicken-C preserved.",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "bC4yF",
          "name": "Motion storyboard",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "0–680ms: pickup scene reveals from the right through a clip-path, like arriving transport. 120–720ms: headline field wipes left-to-right. Text and buttons remain visible immediately. No loop. Reduced motion: final static composition. Pencil shows the finished frame, not live motion.",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
