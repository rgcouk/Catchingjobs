        {
          "type": "text",
          "id": "oal6O",
          "name": "Research",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Ramotion / Tourist Landing Page — clear service action beside a destination scene. https://dribbble.com/shots/20866191-Tourist-Website-Design-business-landing-web-page-site-designer\nTubik / Behance portfolio — illustration and product UI working together. https://www.behance.net/Tubik/",
          "lineHeight": 1.5,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Fntzn",
          "name": "Own stamp",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Turn the orange hero into a useful first step: choose a town, find nearby work, then apply. Existing flock artwork supports location context rather than competing with the search. No vacancy counts or new recruitment claims.",
          "lineHeight": 1.5,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "wf4Lw",
          "name": "Motion handoff",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Pencil is a static design. Selecting a town updates the label and scene marker in 160ms; a single 420ms route stroke reveal connects the search to the marker. No autoplay or illustration loop. Reduced motion: show the route immediately, retain selected-state colour. Search and apply remain immediately available. Desktop targets: HX8md, g0Qish, a11qDu.",
          "lineHeight": 1.5,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "cuJWb",
          "name": "Mobile composition",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The search remains above artwork; all town choices remain visible. 44px quick-town targets and 52/56px primary controls. Art is quiet supporting context, with no hover dependency.",
          "lineHeight": 1.5,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
