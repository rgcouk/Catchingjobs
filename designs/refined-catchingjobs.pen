    {
      "type": "frame",
      "id": "wJvXe",
      "x": 4517.999999999999,
      "y": -40664,
      "name": "23C · Direction, artist research and motion notes",
      "width": 1930,
      "height": 410,
      "fill": "$cj-ivory",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "Tedwe",
          "name": "Concept rationale",
          "fill": "$cj-ink",
          "content": "THE CREW LINEUP — Character performance, not decoration",
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 28,
          "fontWeight": "800"
        },
        {
          "type": "text",
          "id": "bEgtM",
          "name": "Research",
          "fill": "$cj-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Scott Martin / Burnt Toast: https://www.behance.net/BurntToast/info · https://www.behance.net/gallery/42764291/Burnt-Toast-Creative. Studied economical silhouettes and expressive staging; new poses stay in CatchingJobs angular language.",
          "lineHeight": 1.4,
          "fontFamily": "Geist",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "WcGmY",
          "name": "Composition",
          "fill": "$cj-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A centred recruitment headline opens onto a broad orange stage. Chicken and turkey share equal visual status. The darkened flame title field earns readable white type; benefits and actions form one compact closing group.",
          "lineHeight": 1.4,
          "fontFamily": "Geist",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "BA4H3",
          "name": "Motion",
          "fill": "$cj-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One 650ms stage reveal: character artwork settles from scale 0.96 to 1 with a bottom-to-top clip-path wipe, ease cubic-bezier(0.16,1,0.3,1). Text and CTAs remain visible. No loop or bobbing. Reduced motion: static composition; action feedback uses 120ms colour only.",
          "lineHeight": 1.4,
          "fontFamily": "Geist",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Ylbp5",
          "name": "Skills",
          "fill": "$cj-ink",
          "textGrowth": "fixed-width",
          "width": "fill_container",
