      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "qUeCK",
          "name": "Direction",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Doorstep journey — narrative panorama",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 26,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "tVEYH",
          "name": "Artist research",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Studio MUTI · The Journey (Dribbble) and The Inner Realm (Behance). Broad principle: a continuous landscape directs attention, with scale distinguishing the foreground from the quiet environment. No external art copied.",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "aCsoZ",
          "name": "Research links",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "https://dribbble.com/shots/24378907--The-Journey\nhttps://www.behance.net/gallery/145913935/The-Inner-Realm",
          "lineHeight": 1.35,
          "fontFamily": "JetBrains Mono",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "n1S8Bx",
          "name": "Motion",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One 720ms route-stroke disclosure, ease cubic-bezier(0.16,1,0.3,1), once on entry. Reveals door → pickup → team. All copy and controls visible immediately. Reduced-motion: complete static route. No looping characters or parallax.",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 18,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "MfPrY",
          "name": "Material notes",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Existing authored raster scene is reused; headings, actions, route and markers are editable. Darkened approved orange behind white type gives contrast. Benefit strip connects directly into white/ivory page content.",
          "lineHeight": 1.35,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
