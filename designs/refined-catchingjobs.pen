    {
      "type": "frame",
      "id": "B4tJsL",
      "x": 8918,
      "y": -40664,
      "name": "23E · Research and motion direction",
      "width": 1894,
      "height": 380,
      "fill": "#FFFDF0",
      "layout": "vertical",
      "gap": 18,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "u02t2",
          "name": "Direction title",
          "fill": "#362F2B",
          "content": "Friday rhythm / an editorial working-week composition",
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 28,
          "fontWeight": "800"
        },
        {
          "type": "text",
          "id": "PReKG",
          "name": "Research",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Research: Malika Favre — Handsome Frank / Behance (light, negative space, economical colour). Burnt Toast — Dribbble (playful character framing). Broad composition principles only; no artist artwork copied.\nhttps://www.behance.net/gallery/83528681/Malika-Favre\nhttps://dribbble.com/burnttoast",
          "lineHeight": 1.5,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "c9YZO",
          "name": "Motion handoff",
          "fill": "#362F2B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Motion thesis: seven panels reveal once across the working week, resolving on Friday PAY DAY. 40ms stagger + 460ms mask reveal, total 700ms; exponential ease-out. Headline and actions visible immediately. Reduced motion: static final calendar; Friday colour emphasis only. Never loop. Week is conceptual, not a promised shift roster.",
          "lineHeight": 1.5,
          "fontFamily": "Geist",
          "fontSize": 16,
          "fontWeight": "normal"
        }
      ]
    },
