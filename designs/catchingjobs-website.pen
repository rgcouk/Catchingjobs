        {
          "type": "text",
          "id": "t0RzGU",
          "name": "Motion heading",
          "fill": "$cj-ink",
          "content": "One useful movement, then stillness",
          "fontFamily": "Plus Jakarta Sans",
          "fontSize": 28,
          "fontWeight": "700"
