# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: The connection string used by the serverless application.
# IMPORTANT: In a serverless environment like Vercel, this MUST point to a connection pooler
# (e.g., Neon or Supabase pooled connection string, typically port 6543 for Supabase).
DATABASE_URL="postgres://user:password@host:6543/dbname?pgbouncer=true&connection_limit=1"

# DIRECT_URL: The direct database connection string used exclusively for Prisma migrations.
# This avoids running schema migrations through the pooler.
DIRECT_URL="postgres://user:password@host:5432/dbname"

# RESEND_API_KEY: Resend API key for transactional emails and alerts.
# Required by the outbox processor. Missing credentials never simulate delivery.
RESEND_API_KEY="re_123456789"

# EMAIL_FROM: The sender address for emails sent by Catchingjobs.
EMAIL_FROM="Catchingjobs <notifications@send.catchingjobs.co.uk>"

# ADMIN_ALERT_EMAIL: The destination email address for dispatch team notifications.
ADMIN_ALERT_EMAIL="dispatch@pullum.co.uk"

# Clerk: browser publishable key and server credentials (never expose secret keys via VITE_).
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
RESEND_WEBHOOK_SECRET=""
INTAKE_WEBHOOK_SECRET=""
CRON_SECRET=""

# Create a separate PRIVATE Blob store for new identity documents.
BLOB_PRIVATE_READ_WRITE_TOKEN=""
# Existing PUBLIC store token is used only by the reviewed migration script.
BLOB_READ_WRITE_TOKEN=""
DOCUMENT_MIGRATION_MANIFEST="/absolute/protected/path/document-migration.json"

# Optional provider CA in PEM form, with literal \n separators if required.
DATABASE_CA_CERT=""
# Browser origins allowed to make cross-origin API requests, comma separated.
ALLOWED_ORIGINS="http://localhost:3000"
